{
  "name": "hamsafar-frontend",
  "private": true,
  "version": "0.2.0",
  "description": "همسفر — پلتفرم تشکیل گروه سفر و تورهای گروهی (Frontend)",
  "type": "module",
  "packageManager": "bun@1.3.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:standalone": "npm run typecheck && vite build --mode standalone",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "msw:init": "msw init public"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.81.5",
    "lucide-react": "^0.546.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.6.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "trustedDependencies": [
    "msw"
  ]
}